{
  "name": "tools-hub",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-09",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/class-scheduler*"]
  },

  "services": [
    {
      "binding": "CLASS_SCHEDULER",
      "service": "class-scheduler"
    }
  ]
}